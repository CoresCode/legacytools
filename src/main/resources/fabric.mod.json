{
	"schemaVersion": 1,
	"id": "legacytools",
	"version": "${version}",
	"name": "Legacy Tools",
	"description": "Restore ancient tools through use, unlock powerful abilities, and preserve their legacy.",
	"authors": [
		"CoresCode"
	],
	"contact": {
		"homepage": "https://github.com/CoresCode/legacytools",
		"issues": "https://github.com/CoresCode/legacytools/issues"
	},
	"license": "All rights reserved",
	"icon": "assets/legacytools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.corescode.legacytools.LegacyTools"
		],
		"client": [
			"com.corescode.legacytools.client.LegacyToolsClient"
		]
	},
	"mixins": [
		"legacytools.mixins.json",
		{
			"config": "legacytools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}